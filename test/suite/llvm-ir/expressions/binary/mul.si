struct Point
{
    x: int,
    y: int,
}

var g_prod: int = 3 * 2;
var g: int = 7;

// CHECK: {{$GLOBAL}} = {{.*}}global i32 6
// CHECK: {{$GLOBAL}} = {{.*}}global i32 7

fn mul_ubyte() void
{
    var a: ubyte = 3;
    var b: ubyte = 2;
    var c: ubyte = a * b;
}

// CHECK-LABEL: define void {{$FN(mul_ubyte)}}()
// CHECK:      [[A:]] = alloca i8
// CHECK-NEXT: [[B:]] = alloca i8
// CHECK-NEXT: [[C:]] = alloca i8
// CHECK:      store i8 3, ptr [[A]]
// CHECK-NEXT: store i8 2, ptr [[B]]
// CHECK:      [[A1:]] = load i8, ptr [[A]]
// CHECK-NEXT: [[B1:]] = load i8, ptr [[B]]
// CHECK-NEXT: [[S:]] = mul i8 [[A1]], [[B1]]
// CHECK-NEXT: store i8 [[S]], ptr [[C]]
// CHECK-NEXT: ret void

