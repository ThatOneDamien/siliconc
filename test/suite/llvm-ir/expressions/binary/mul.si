// CHECK-NEXT: [[QV:]] = load i32, ptr [[Q1]]
// CHECK-NEXT: [[S:]] = mul i32 [[PV]], [[QV]]
// CHECK-NEXT: store i32 [[S]], ptr [[R]]
// CHECK-NEXT: ret void

