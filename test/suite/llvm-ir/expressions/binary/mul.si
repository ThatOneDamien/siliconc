fn f() int
{
    return 1;
}

// CHECK-LABEL: define i32 {{$FN(f)}}()
// CHECK: ret i32

fn h() int
{
    return 2;
}

// CHECK-LABEL: define i32 {{$FN(h)}}()
// CHECK: ret i32

fn call_order() void
{
    var r: int = f() * h();
}

// CHECK-LABEL: define void {{$FN(call_order)}}()
// CHECK:      [[R:]] = alloca i32
// CHECK:      [[F:]] = call i32 {{$FN(f)}}()
// CHECK-NEXT: [[H:]] = call i32 {{$FN(h)}}()
// CHECK-NEXT: [[S:]] = mul i32 [[F]], [[H]]
// CHECK-NEXT: store i32 [[S]], ptr [[R]]
// CHECK-NEXT: ret void

fn use_struct() void
{
    var s: Point;
    s.x = 1;
    s.y = 2;
    var r: int = s.x * s.y;
}

// CHECK-LABEL: define void {{$FN(use_struct)}}()
// CHECK:      [[S:]] = alloca {{.*}}
// CHECK-NEXT: [[R:]] = alloca i32
// CHECK:      store i32 1, ptr [[S]]
// CHECK:      [[PY:]] = getelementptr {{.*}}, ptr [[S]], i32 0, i32 1
// CHECK:      store i32 2, ptr [[PY]]
// CHECK-NEXT: [[X:]] = load i32, ptr [[S]]
// CHECK-NEXT: [[PY2:]] = getelementptr {{.*}}, ptr [[S]], i32 0, i32 1
// CHECK-NEXT: [[Y:]] = load i32, ptr [[PY2]]
// CHECK-NEXT: [[P:]] = mul i32 [[X]], [[Y]]
// CHECK-NEXT: store i32 [[P]], ptr [[R]]
// CHECK-NEXT: ret void

fn use_array() void
{
    var arr: [4]int;
    arr[0] = 1;
    arr[1] = 2;
    var r: int = arr[0] * arr[1];
}

// CHECK-LABEL: define void {{$FN(use_array)}}()
// CHECK:      [[ARR:]] = alloca [4 x i32]
// CHECK-NEXT: [[R:]] = alloca i32
// CHECK:      store i32 2, ptr {{$VAL}}
// CHECK:      [[E0:]] = getelementptr i32, ptr [[ARR]], i64 0
// CHECK-NEXT: [[V0:]] = load i32, ptr [[E0]]
// CHECK-NEXT: [[E1:]] = getelementptr i32, ptr [[ARR]], i64 1
// CHECK-NEXT: [[V1:]] = load i32, ptr [[E1]]
// CHECK-NEXT: [[P:]] = mul i32 [[V0]], [[V1]]
// CHECK-NEXT: store i32 [[P]], ptr [[R]]
// CHECK-NEXT: ret void

fn use_deref() void
{
    var a: int = 1;
    var b: int = 2;
    var p: *int = &a;
    var q: *int = &b;
    var r: int = *p * *q;
}

// CHECK-LABEL: define void {{$FN(use_deref)}}()
// CHECK:      [[A:]] = alloca i32
