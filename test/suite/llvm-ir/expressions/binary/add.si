// CHECK-LABEL: define void {{$FN(arg_ctx)}}()
// CHECK:      [[A:]] = alloca i32
// CHECK-NEXT: [[B:]] = alloca i32
// CHECK:      store i32 2, ptr [[B]]
// CHECK:      [[A1:]] = load i32, ptr [[A]]
// CHECK-NEXT: [[B1:]] = load i32, ptr [[B]]
// CHECK-NEXT: [[S:]] = add i32 [[A1]], [[B1]]
// CHECK-NEXT: call void {{$FN(take)}}(i32 [[S]])
// CHECK-NEXT: ret void

fn ret_ctx() int
{
    var a: int = 1;
    var b: int = 2;
    return a + b;
}

// CHECK-LABEL: define i32 {{$FN(ret_ctx)}}()
// CHECK:      [[A:]] = alloca i32
// CHECK-NEXT: [[B:]] = alloca i32
// CHECK:      store i32 2, ptr [[B]]
// CHECK:      [[A1:]] = load i32, ptr [[A]]
// CHECK-NEXT: [[B1:]] = load i32, ptr [[B]]
// CHECK-NEXT: [[S:]] = add i32 [[A1]], [[B1]]
// CHECK:      ret i32

fn cond_ctx() void
{
    var a: int = 1;
    var b: int = 2;
    if a + b > 0
    {
        a = 0;
    }
}

// CHECK-LABEL: define void {{$FN(cond_ctx)}}()
// CHECK:      [[A:]] = alloca i32
// CHECK-NEXT: [[B:]] = alloca i32
// CHECK:      store i32 2, ptr [[B]]
// CHECK:      [[A1:]] = load i32, ptr [[A]]
// CHECK-NEXT: [[B1:]] = load i32, ptr [[B]]
// CHECK-NEXT: [[S:]] = add i32 [[A1]], [[B1]]
// CHECK-NEXT: [[C:]] = icmp sgt i32 [[S]], 0
// CHECK-NEXT: br i1 [[C]], label {{$VAL}}, label {{$VAL}}

fn index_ctx() void
{
    var arr: [4]int;
    var a: uint = 1;
    var b: uint = 2;
    var r: int = arr[a + b];
}

// CHECK-LABEL: define void {{$FN(index_ctx)}}()
// CHECK:      [[ARR:]] = alloca [4 x i32]
// CHECK-NEXT: [[A:]] = alloca i32
// CHECK-NEXT: [[B:]] = alloca i32
// CHECK-NEXT: [[R:]] = alloca i32
// CHECK:      store i32 2, ptr [[B]]
// CHECK:      [[A1:]] = load i32, ptr [[A]]
// CHECK-NEXT: [[B1:]] = load i32, ptr [[B]]
// CHECK-NEXT: [[S:]] = add i32 [[A1]], [[B1]]
// CHECK-NEXT: [[SX:]] = zext i32 [[S]] to i64
// CHECK-NEXT: [[E:]] = getelementptr i32, ptr [[ARR]], i64 [[SX]]
// CHECK-NEXT: [[V:]] = load i32, ptr [[E]]
// CHECK-NEXT: store i32 [[V]], ptr [[R]]
// CHECK-NEXT: ret void
